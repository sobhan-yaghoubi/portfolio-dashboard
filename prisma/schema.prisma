generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String  @id @default(uuid())
  password String
  image    String?
  name     String?
  family   String?
  phone    String?
  email    String  @unique
  location String?
  bio      String?
}

model Project {
  id                 String           @id @default(uuid())
  image              String
  title              String
  link               String
  source             String
  description        String
  technicalSkillList TechnicalSkill[] @relation("ProjectToTechnicalSkill")
}

model TechnicalSkill {
  id                 String             @id @default(uuid())
  name               String
  image              String
  link               String
  description        String
  experienceYearTime experienceYearTime
  projectList        Project[]          @relation("ProjectToTechnicalSkill")
}

model SoftSkill {
  id    String @id @default(uuid())
  name  String
  score Int
}

model TechnicalGrowth {
  id          String @id @default(uuid())
  title       String
  subtitle    String
  description String
  order       Int
}

model SocialMedia {
  id          String  @id @default(uuid())
  title       String
  subtitle    String
  description String
  link        String
  username    String
  logo        String?
  backImage   String?
}

enum experienceYearTime {
  LESS_ONE_YEAR
  BETWEEN_ONE_AND_TWO_YEAR
  BETWEEN_TWO_AND_FOUR_YEAR
  BETWEEN_FOUR_AND_TEN_YEAR
  MORE_TEN_YEAR
}
